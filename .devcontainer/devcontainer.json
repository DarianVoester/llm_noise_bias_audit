{
  "name": "LLM Noise & Bias Audit Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {},
  "postCreateCommand": "pip install --require-hashes -r requirements.txt && pip install --require-hashes -r requirements-dev.txt",
  "postAttachCommand": "bash scripts/start_app.sh; echo; echo 'Restart the app: press Ctrl+Shift+B, or use the button in the app sidebar (App: restart or stop).'; echo 'Optional free local models: bash scripts/install_ollama.sh'",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit UI",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false",
    "STREAMLIT_SERVER_HEADLESS": "true",
    "OLLAMA_HOST": "127.0.0.1:11434"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}

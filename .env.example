# LLM Noise & Bias Audit Studio — environment variable template
#
# RECOMMENDED: do NOT create a .env file. Instead store keys as GitHub Codespaces
# Secrets (GitHub -> Settings -> Codespaces -> Secrets). They are injected as
# environment variables and do not touch the repository.
#
# Alternatively, paste keys into the app sidebar: the app is designed to keep them only
# in the volatile Streamlit session and not to write them to disk, logs, or exports
# (best effort, no guarantee - see DISCLAIMER.md).
#
# All variables are OPTIONAL. Without any key the app runs in Mock mode and
# with local Ollama / custom models.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Keys for servers of your own (models/models.toml, `api_key_env`) need a variable of
# their own, e.g. MY_SERVER_KEY=...  The four provider keys above are never sent to
# custom endpoints.

# Local Ollama server (loopback only; never expose this port)
OLLAMA_API_BASE=http://127.0.0.1:11434

# Path to your own model registry (see docs/BRING_YOUR_OWN_MODEL.md)
LLM_NOISE_MODELS_FILE=models/models.toml

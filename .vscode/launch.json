{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: debug app.py",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8501", "--server.address", "127.0.0.1"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "preLaunchTask": "App: Stop"
    }
  ]
}
